{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tinkermonkey.github.io/code-wrapper/claude-event.v1.schema.json",
  "title": "Claude Event Schema v1",
  "description": "Wire protocol event format for code-wrapper binary NDJSON output. Each line in the NDJSON stream is a JSON object conforming to one of the ClaudeEvent discriminated union types. The top-level discriminator is the \"type\" field. Wire protocol version is indicated by the \"v\" field (currently 1). All events MUST include the \"v\" field set to 1 for this schema version.",
  "oneOf": [
    {
      "$ref": "#/definitions/TextEvent"
    },
    {
      "$ref": "#/definitions/ThinkingEvent"
    },
    {
      "$ref": "#/definitions/ToolUseEvent"
    },
    {
      "$ref": "#/definitions/ToolResultEvent"
    },
    {
      "$ref": "#/definitions/ProgressEvent"
    },
    {
      "$ref": "#/definitions/ReadyEvent"
    },
    {
      "$ref": "#/definitions/RetryEvent"
    },
    {
      "$ref": "#/definitions/DoneEvent"
    },
    {
      "$ref": "#/definitions/ErrorEvent"
    },
    {
      "$ref": "#/definitions/RawEvent"
    }
  ],
  "definitions": {
    "TextEvent": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "description": "Wire protocol version — added by exec binary on output"
        },
        "seq": {
          "type": "number",
          "description": "Monotonic across all events in a run — safe for replay and deduplication"
        },
        "timestamp": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "const": "text"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "seq",
        "text",
        "timestamp",
        "type",
        "v"
      ]
    },
    "ThinkingEvent": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "description": "Wire protocol version — added by exec binary on output"
        },
        "seq": {
          "type": "number",
          "description": "Monotonic across all events in a run — safe for replay and deduplication"
        },
        "timestamp": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "const": "thinking"
        },
        "thinking": {
          "type": "string",
          "description": "Extended thinking content from the model"
        }
      },
      "required": [
        "seq",
        "thinking",
        "timestamp",
        "type",
        "v"
      ]
    },
    "ToolUseEvent": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "description": "Wire protocol version — added by exec binary on output"
        },
        "seq": {
          "type": "number",
          "description": "Monotonic across all events in a run — safe for replay and deduplication"
        },
        "timestamp": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "const": "tool_use"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "input": {
          "description": "Full tool input as received from the CLI"
        }
      },
      "required": [
        "id",
        "input",
        "name",
        "seq",
        "timestamp",
        "type",
        "v"
      ]
    },
    "ToolResultEvent": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "description": "Wire protocol version — added by exec binary on output"
        },
        "seq": {
          "type": "number",
          "description": "Monotonic across all events in a run — safe for replay and deduplication"
        },
        "timestamp": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "const": "tool_result"
        },
        "toolUseId": {
          "type": "string"
        },
        "isError": {
          "type": "boolean"
        },
        "output": {
          "type": "string",
          "description": "Full combined text output from the tool result content blocks"
        }
      },
      "required": [
        "isError",
        "output",
        "seq",
        "timestamp",
        "toolUseId",
        "type",
        "v"
      ]
    },
    "ProgressEvent": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "description": "Wire protocol version — added by exec binary on output"
        },
        "seq": {
          "type": "number",
          "description": "Monotonic across all events in a run — safe for replay and deduplication"
        },
        "timestamp": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "const": "progress"
        },
        "elapsed": {
          "type": "number",
          "description": "Seconds elapsed since process start"
        }
      },
      "required": [
        "elapsed",
        "seq",
        "timestamp",
        "type",
        "v"
      ]
    },
    "ReadyEvent": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "description": "Wire protocol version — added by exec binary on output"
        },
        "seq": {
          "type": "number",
          "description": "Monotonic across all events in a run — safe for replay and deduplication"
        },
        "timestamp": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "const": "ready"
        },
        "sessionId": {
          "type": "string",
          "description": "CLI-assigned session ID — available at process start, before the done event"
        },
        "model": {
          "type": "string",
          "description": "Model being used for this run"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of tools available to the agent"
        }
      },
      "required": [
        "seq",
        "sessionId",
        "timestamp",
        "type",
        "v"
      ]
    },
    "RetryEvent": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "description": "Wire protocol version — added by exec binary on output"
        },
        "seq": {
          "type": "number",
          "description": "Monotonic across all events in a run — safe for replay and deduplication"
        },
        "timestamp": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "const": "retry"
        },
        "attempt": {
          "type": "number",
          "description": "Attempt number (1-based)"
        },
        "delayMs": {
          "type": "number",
          "description": "Delay before this retry in milliseconds"
        },
        "error": {
          "type": "string",
          "description": "Error message that triggered the retry"
        }
      },
      "required": [
        "attempt",
        "seq",
        "timestamp",
        "type",
        "v"
      ]
    },
    "DoneEvent": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "description": "Wire protocol version — added by exec binary on output"
        },
        "seq": {
          "type": "number",
          "description": "Monotonic across all events in a run — safe for replay and deduplication"
        },
        "timestamp": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "const": "done"
        },
        "sessionId": {
          "type": "string",
          "description": "CLI-assigned session ID — store this and pass as sessionId on the next turn"
        },
        "usage": {
          "type": "object",
          "properties": {
            "inputTokens": {
              "type": "number"
            },
            "outputTokens": {
              "type": "number"
            },
            "cacheReadInputTokens": {
              "type": "number"
            },
            "cacheCreationInputTokens": {
              "type": "number"
            }
          },
          "required": [
            "inputTokens",
            "outputTokens"
          ]
        },
        "resultText": {
          "type": "string",
          "description": "Claude's own final summary/answer text (`result.result`) — distinct from the streamed `assistant` text blocks. Claude-only: Copilot's ACP `session/prompt` ack carries no equivalent field, and its final answer is already fully covered by the streamed `TextEvent`s, so this is left unset rather than populated from something that isn't actually there."
        },
        "isError": {
          "type": "boolean",
          "description": "Claude's `result.is_error` — whether the turn ended in an error state"
        },
        "durationMs": {
          "type": "number",
          "description": "Claude's `result.duration_ms` — wall-clock duration of the turn"
        },
        "totalCostUsd": {
          "type": "number",
          "description": "Claude's `result.total_cost_usd`"
        },
        "numTurns": {
          "type": "number",
          "description": "Claude's `result.num_turns`"
        },
        "stopReason": {
          "type": "string",
          "description": "Copilot ACP's `session/prompt` ack `result.stopReason` (e.g. `'end_turn'`). Copilot-only — Claude's `result` event has no equivalent field."
        }
      },
      "required": [
        "seq",
        "sessionId",
        "timestamp",
        "type",
        "v"
      ]
    },
    "ErrorEvent": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "description": "Wire protocol version — added by exec binary on output"
        },
        "seq": {
          "type": "number",
          "description": "Monotonic across all events in a run — safe for replay and deduplication"
        },
        "timestamp": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "const": "error"
        },
        "code": {
          "$ref": "#/definitions/ErrorCode"
        },
        "detail": {
          "type": "string"
        },
        "exitCode": {
          "type": "number"
        }
      },
      "required": [
        "code",
        "detail",
        "seq",
        "timestamp",
        "type",
        "v"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "idle_timeout",
        "max_timeout",
        "nonzero_exit",
        "rate_limit",
        "spawn_error",
        "internal_error",
        "stale_session",
        "parse_error",
        "cli_error",
        "wire_protocol_error",
        "aborted"
      ]
    },
    "RawEvent": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "description": "Wire protocol version — added by exec binary on output"
        },
        "seq": {
          "type": "number",
          "description": "Monotonic across all events in a run — safe for replay and deduplication"
        },
        "timestamp": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "const": "raw"
        },
        "rawType": {
          "type": "string",
          "description": "The 'type' field from the raw CLI event"
        },
        "rawSubtype": {
          "type": "string",
          "description": "The 'subtype' field if present"
        },
        "data": {
          "description": "The full raw parsed JSON object — nothing is discarded"
        }
      },
      "required": [
        "data",
        "rawType",
        "seq",
        "timestamp",
        "type",
        "v"
      ]
    },
    "ClaudeEventType": {
      "type": "string",
      "enum": [
        "text",
        "thinking",
        "tool_use",
        "tool_result",
        "progress",
        "ready",
        "retry",
        "done",
        "error",
        "raw"
      ]
    },
    "BaseEvent": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "description": "Wire protocol version — added by exec binary on output"
        },
        "seq": {
          "type": "number",
          "description": "Monotonic across all events in a run — safe for replay and deduplication"
        },
        "timestamp": {
          "type": "number"
        },
        "type": {
          "$ref": "#/definitions/ClaudeEventType"
        }
      },
      "required": [
        "seq",
        "timestamp",
        "type",
        "v"
      ]
    },
    "WireProtocolVersion": {
      "type": "number",
      "const": 1,
      "description": "Wire protocol version literal for schema validation."
    }
  }
}
