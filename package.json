{
  "name": "@tinkermonkey/code-wrapper",
  "version": "0.1.0",
  "description": "Reusable Node.js module for AI coding agent CLIs — process launch, event normalization, session management",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./process": {
      "types": "./dist/process/index.d.ts",
      "import": "./dist/process/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js"
    },
    "./sessions": {
      "types": "./dist/sessions/index.d.ts",
      "import": "./dist/sessions/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "npm run generate-schema && tsc",
    "generate-schema": "tsx scripts/generate-schema.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.config.live.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "claude-code",
    "github-copilot",
    "ai",
    "cli",
    "wrapper",
    "sessions"
  ],
  "author": "tinkermonkey",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@github/copilot": "^1.0.68"
  }
}
