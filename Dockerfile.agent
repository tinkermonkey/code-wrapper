# ============================================================================
# Dockerfile.agent for code-wrapper project
# ============================================================================
# Builds the AGENT IMAGE for Claude agents to operate within.
# Source code is mounted at runtime via:
#   docker run -v /host/project:/workspace ...
# ============================================================================

# ============================================================================
# Stage 1: Base Environment from Orchestrator
# ============================================================================
FROM switchyard-orchestrator:latest

# The base image already includes:
# - Claude CLI (REQUIRED - must be present)
# - Git CLI (REQUIRED - must be present)
# - GitHub CLI (REQUIRED - must be present)
# - Node.js 22 with npm
# - Python 3.11
# - Essential build tools
# - procps package (provides 'ps' command needed by Claude CLI)

USER root

# ============================================================================
# Stage 2: GitHub CLI Auth Entrypoint
# ============================================================================
COPY agent-entrypoint.sh /usr/local/bin/agent-entrypoint.sh
RUN chmod +x /usr/local/bin/agent-entrypoint.sh

# ============================================================================
# Stage 3: Pre-install Dependencies at /opt/deps
# ============================================================================
# Dependencies MUST be baked outside /workspace entirely — the runtime bind
# mount shadows the entire /workspace subtree.
WORKDIR /opt/deps

# Node.js dependencies
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts --include=dev && \
    rm -f package.json package-lock.json

# Python dependencies for py-code-wrapper (use a venv so it's a single
# extractable directory)
COPY py-code-wrapper/pyproject.toml py-code-wrapper/setup.py /tmp/py-code-wrapper/
RUN mkdir -p /tmp/py-code-wrapper/src/code_wrapper && \
    touch /tmp/py-code-wrapper/src/code_wrapper/__init__.py
RUN python3 -m venv /opt/deps/.venv && \
    /opt/deps/.venv/bin/pip install --upgrade pip && \
    /opt/deps/.venv/bin/pip install --no-cache-dir "/tmp/py-code-wrapper[dev,codegen]" && \
    rm -rf /tmp/py-code-wrapper

# ============================================================================
# Stage 3.5: Install GitHub Copilot CLI
# ============================================================================
RUN --mount=type=cache,target=/root/.npm \
    npm install -g --ignore-scripts @github/copilot

# ============================================================================
# Stage 4: Ownership and Permissions
# ============================================================================
RUN chown -R orchestrator:orchestrator /opt/deps

# ============================================================================
# Stage 5: Switch to Runtime User
# ============================================================================
USER orchestrator

# ============================================================================
# Stage 6: Verification (MANDATORY)
# ============================================================================
RUN claude --version && \
    git --version && \
    gh --version && \
    copilot --version && \
    node --version && \
    npm --version && \
    /opt/deps/.venv/bin/python3 -c "from datamodel_code_generator import generate; print('datamodel-code-generator OK')"

ENTRYPOINT ["/usr/local/bin/agent-entrypoint.sh"]
CMD ["/bin/bash"]
